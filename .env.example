# ============================================================
# LenzooCRM - Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# No Coolify, configure estas variáveis no painel de Environment Variables
# ============================================================

# --- Banco de Dados ---
POSTGRES_DB=lenzoocrm
POSTGRES_USER=lenzoo_user
POSTGRES_PASSWORD=troque_por_uma_senha_forte

# --- Backend ---
JWT_SECRET=troque_por_um_secret_longo_e_aleatorio
ALLOWED_ORIGIN=*

# --- Stripe (Pagamentos) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
